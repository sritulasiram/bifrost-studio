<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Registered by the app with SMAppService.agent(plistName:). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@BIFROST_AGENT_LABEL@</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/bifrost-agent</string>
    <key>MachServices</key>
    <dict>
        <key>@BIFROST_AGENT_LABEL@</key>
        <true/>
    </dict>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>@BIFROST_BUNDLE_ID@</string>
    </array>
    <key>ProcessType</key>
    <string>Standard</string>
    <!-- On SIGTERM a running flash stops at the next sequence boundary;
         give a large sequence time to commit before SIGKILL. -->
    <key>ExitTimeOut</key>
    <integer>300</integer>
</dict>
</plist>
